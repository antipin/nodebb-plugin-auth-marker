{
  "name": "nodebb-plugin-auth-marker",
  "version": "0.0.0-development",
  "description": "Sets an nbb_auth cookie (1 = logged in, 0 = guest) so a reverse proxy can cache guest pages and bypass the cache for logged-in users",
  "main": "library.js",
  "files": [
    "library.js",
    "plugin.json"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "eslint --max-warnings 0 .",
    "test": "node --test",
    "test:integration": "node --test --test-concurrency=1 integration/marker.integration.js integration/proxy.integration.js",
    "test:pack": "node integration/pack.js",
    "test:up": "npm run test:pack && node integration/proxy/extract.js && docker compose -f integration/docker-compose.yml up -d --wait",
    "test:down": "docker compose -f integration/docker-compose.yml down -v",
    "test:logs": "docker compose -f integration/docker-compose.yml logs nodebb"
  },
  "keywords": [
    "nodebb",
    "nodebb-plugin",
    "nginx",
    "varnish",
    "reverse-proxy",
    "cache",
    "cookie"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antipin/nodebb-plugin-auth-marker.git"
  },
  "bugs": {
    "url": "https://github.com/antipin/nodebb-plugin-auth-marker/issues"
  },
  "homepage": "https://github.com/antipin/nodebb-plugin-auth-marker#readme",
  "author": "Alex Antipin",
  "license": "MIT",
  "nbbpm": {
    "compatibility": "^4.0.0"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "release": {
    "branches": [
      "main"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@stylistic/eslint-plugin": "^5.10.0",
    "eslint": "^10.14.0",
    "eslint-config-nodebb": "^2.0.3",
    "husky": "^9.1.7",
    "semantic-release": "^25.0.9"
  },
  "dependencies": {
    "on-headers": "^1.1.0"
  }
}
